# Python AI engine (FastAPI + LangGraph agents)
# Build context: repository root
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app/ai-engine

COPY ai-engine/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt

COPY ai-engine ./

# Generated projects are written to <repo-root>/generated-projects
RUN mkdir -p /app/generated-projects

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
