# Application
NODE_ENV=development

# Backend (Node.js / Express)
PORT=5000
BACKEND_URL=http://localhost:5000

# Frontend (React)
# Vite exposes only variables prefixed with VITE_
VITE_API_BASE_URL=http://localhost:5000/api

# MongoDB
# Local Community Server example: mongodb://127.0.0.1:27017/multi_agent_assistant
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/multi_agent_assistant
MONGODB_URI=mongodb://127.0.0.1:27017/multi_agent_assistant

# Python AI Engine
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://127.0.0.1:8000

# LLM Providers — every key is optional; with none set the engine runs deterministic
# mock templates. Models are tried in order: the selected provider's models first, then
# the remaining configured providers (gemini -> groq -> openrouter -> openai -> ollama),
# so a quota error (HTTP 429) moves on instead of failing the run.

# Gemini — free key at https://aistudio.google.com/apikey (free tier ~20 requests/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Groq — free key at https://console.groq.com/keys (largest free tier, OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# OpenRouter — free key at https://openrouter.ai/keys; ":free" models cost nothing.
# Free model availability changes over time — check https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
OPENROUTER_FALLBACK_MODELS=

# OpenAI — paid; leave empty unless you have credit
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=

# Ollama — local models, no key and no quota. Install https://ollama.com, run
# `ollama pull qwen2.5-coder:7b`, then set OLLAMA_ENABLED=true.
# In Docker use http://host.docker.internal:11434/v1 to reach the host daemon.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODELS=

# Default LLM provider: gemini | groq | openrouter | openai | ollama
LLM_PROVIDER=gemini
